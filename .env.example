# Nur für die API-Routen des Servers (KI-Assistent), nie in die App

# KI-Anbieter: "anthropic" (Standard) oder "openai"
AI_PROVIDER=anthropic

# Anthropic (Standard): Key aus der Anthropic-Konsole
ANTHROPIC_API_KEY=

# OpenAI oder ein OpenAI-kompatibler Dienst: Key aus der OpenAI-Plattform
OPENAI_API_KEY=
# Modell für OpenAI; muss Structured Outputs unterstützen
OPENAI_MODEL=gpt-6-astra
# Optional: anderer Endpunkt, z. B. ein OpenAI-kompatibler Anbieter oder ein Gateway
# OPENAI_BASE_URL=https://api.openai.com/v1
